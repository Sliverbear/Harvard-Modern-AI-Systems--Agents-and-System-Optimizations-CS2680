# Copy to your shell environment (Mads-Lens does not read .env files automatically).
# MADS_PORT=5174
# MADS_CLAUDE_BIN=claude
# MADS_MODEL=            # empty = Claude Code default model; e.g. "haiku" to save usage while testing
# MADS_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash(pytest:*),Bash(python:*),Bash(ls:*),Task,Agent
# MADS_DANGEROUS_SKIP_PERMISSIONS=0   # 1 = pass --dangerously-skip-permissions (scratch dirs only!)
# MADS_DATA_DIR=./data
